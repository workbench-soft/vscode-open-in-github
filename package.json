{
  "name": "open-in-remote-repo",
  "displayName": "Open in Remote Repo",
  "description": "Open or copy a link to a file or folder on GitHub, GitLab or Bitbucket. Links point to main or master.",
  "license": "MIT",
  "version": "1.19.0",
  "publisher": "workbench-soft",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "multi-root ready",
    "vscode",
    "github",
    "gitlab",
    "bitbucket",
    "git"
  ],
  "homepage": "https://github.com/workbench-soft/vscode-open-in-github",
  "repository": {
    "type": "git",
    "url": "https://github.com/workbench-soft/vscode-open-in-github.git"
  },
  "bugs": "https://github.com/workbench-soft/vscode-open-in-github/issues",
  "main": "./out/extension.js",
  "icon": "./assets/icon.jpg",
  "contributes": {
    "menus": {
      "editor/context": [
        {
          "command": "openInGithub.openInGitHubFile",
          "group": "OpenInGithub",
          "when": "editorTextFocus"
        },
        {
          "command": "openInGithub.copyInGitHubFile",
          "group": "OpenInGithub",
          "when": "editorTextFocus"
        }
      ],
      "explorer/context": [
        {
          "command": "openInGithub.openInGitHubExplorer",
          "group": "OpenInGithub"
        },
        {
          "command": "openInGithub.copyInGitHubExplorer",
          "group": "OpenInGithub"
        }
      ],
      "commandPalette": [
        {
          "command": "openInGithub.openInGitHubExplorer",
          "when": "false"
        },
        {
          "command": "openInGithub.copyInGitHubExplorer",
          "when": "false"
        }
      ]
    },
    "commands": [
      {
        "command": "openInGithub.openInGitHubFile",
        "title": "%openFile%"
      },
      {
        "command": "openInGithub.openInGitHubBlame",
        "title": "%openBlame%"
      },
      {
        "command": "openInGithub.openInGitHubHistory",
        "title": "%openHistory%"
      },
      {
        "command": "openInGithub.copyInGitHubFile",
        "title": "%copyFile%"
      },
      {
        "command": "openInGithub.copyInGitHubBlame",
        "title": "%copyBlame%"
      },
      {
        "command": "openInGithub.copyInGitHubHistory",
        "title": "%copyHistory%"
      },
      {
        "command": "openInGithub.openInGitHubExplorer",
        "title": "%openUrl%"
      },
      {
        "command": "openInGithub.copyInGitHubExplorer",
        "title": "%copyUrl%"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "%configTitle%",
      "properties": {
        "openInGitHub.defaultBranch": {
          "scope": "resource",
          "type": "string",
          "default": "",
          "description": "%defaultBranch%"
        },
        "openInGitHub.defaultRemote": {
          "scope": "resource",
          "type": "string",
          "default": "origin",
          "description": "%defaultRemote%"
        },
        "openInGitHub.repositoryType": {
          "scope": "resource",
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "github",
            "bitbucket",
            "bitbucket-server",
            "gitlab"
          ],
          "enumDescriptions": [
            "%repoAuto%",
            "%repoGithub%",
            "%repoBitbucket%",
            "%repoBitbucketServer%",
            "%repoGitlab%"
          ],
          "description": "%repositoryType%"
        },
        "openInGitHub.remoteURLMapping": {
          "scope": "resource",
          "type": "object",
          "default": {},
          "description": "%remoteURLMapping%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node ./build.js",
    "watch": "node ./build.js --watch",
    "package": "npm run typecheck && node ./build.js --production",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint",
    "compile-tests": "tsc -p .",
    "watch-tests": "tsc -p . -w",
    "test:unit": "npm run compile-tests && mocha --ui tdd \"out/src/**/*.test.js\"",
    "pretest": "npm run compile-tests && npm run compile",
    "test": "node ./out/src/test-host/run.js",
    "lint:staged": "lint-staged --no-stash",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/mocha": "^9.1.1",
    "@types/node": "^16.x",
    "@types/vscode": "^1.75.0",
    "@vscode/test-electron": "^2.1.5",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.15.6",
    "lint-staged": "^10.1.3",
    "mocha": "^10.0.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "pre-commit": "^1.2.2",
    "typescript": "^4.8.2"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,md,yml,yaml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "pre-commit": [
    "lint:staged"
  ],
  "l10n": "./l10n"
}
