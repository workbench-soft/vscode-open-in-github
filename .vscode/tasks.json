// Build tasks that launch.json runs before it opens VS Code.
// Each one calls an npm script from package.json and reads its errors with
// the tsc watch problem matcher.
{
  "version": "2.0.0",
  "problemMatcher": "$tsc-watch",
  "tasks": [
    {
      "label": "npm:compile",
      "type": "shell",
      "command": "npm",
      "args": ["run", "compile", "--loglevel", "silent"],
      "isBackground": true,
      "problemMatcher": "$tsc-watch",
      "group": {
        "_id": "build",
        "isDefault": false
      }
    },
    {
      "label": "npm:compile-tests",
      "type": "shell",
      "command": "npm",
      "args": ["run", "compile-tests", "--loglevel", "silent"],
      "isBackground": true,
      "problemMatcher": "$tsc-watch",
      "group": {
        "_id": "build",
        "isDefault": false
      }
    }
  ]
}
