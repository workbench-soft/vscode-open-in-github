// Workspace settings for this repo, applied over the user settings.
{
  // Keep the compiled out folder in the explorer.
  "files.exclude": {
    "out": false
  },
  // Leave the compiled out folder out of search results.
  "search.exclude": {
    "out": true
  },
  // Use the TypeScript version pinned in package.json.
  "typescript.tsdk": "./node_modules/typescript/lib"
}
